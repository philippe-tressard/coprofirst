#!/bin/sh
# Refuse un push sur `dev` ou `main` sans pré-check MEP passé pour CE commit.
#
# POURQUOI. Sur ce projet, `auto-deploy.sh` déploie `origin/main` toutes les cinq
# minutes : **fusionner vers `main` est la mise en production**.
#
# CE QU'IL GARDE AUJOURD'HUI (#2908). L'ordre d'un lot (`CLAUDE.md`, « Ordre d'un
# lot ») ne pousse plus sur `dev` ni sur `main` à la main : le lot part sur SA
# branche, sa PR passe la CI, puis le pré-check, puis `conduire-mep.sh` — qui pousse
# la version sur `dev` sous `SKIP_PRECHECK=1`. Ce hook ne juge donc plus que le push
# À LA MAIN sur `dev` ou `main`, celui qui contournerait ce chemin : il le refuse
# sans la trace d'un pré-check passé sur le commit qui part. La branche d'un lot
# passe sans trace — son pré-check vient après sa CI.
#
# Cet ordre était juste, et il a quand même été enfreint sur trois lots d'affilée
# les 07 et 08/08/2026, au motif que « s'arrêter au push dev » dispenserait du
# pré-check. Troisième récidive du même défaut (socle 01 §2). La conclusion du
# socle vaut pour elle-même : une consigne ne se maintient pas seule, il lui faut
# un contrôle qui échoue.
#
# Le hook ne rejoue pas les points du pré-check — il exige leur TRACE, produite par
# `precheck-mep.sh`, et liée au commit exact qui part. Un pré-check passé sur un
# autre commit ne vaut rien : c'est la version poussée qui sera déployée.
#
# Contournement ponctuel, à assumer : SKIP_PRECHECK=1 git push ...

[ -n "$SKIP_PRECHECK" ] && {
    echo "⚠ pre-push : pré-check DÉLIBÉRÉMENT contourné (SKIP_PRECHECK=1)." >&2
    exit 0
}

#  Répertoire git DU clone : `.git` est un fichier dans un worktree (#1226).
. "$(git rev-parse --show-toplevel)/scripts/lib/lib-depot.sh"
MARQUEUR="$(dossier_git)/precheck-mep.ok"

# stdin : <ref locale> <sha local> <ref distante> <sha distant>
protege=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue  # suppression
    case "$remote_ref" in
        refs/heads/dev|refs/heads/main) protege="$local_sha" ;;
    esac
done

[ -z "$protege" ] && exit 0     # aucune branche surveillée : rien à exiger

refuser() {
    echo "" >&2
    echo "✗ pre-push refusé — $1" >&2
    echo "" >&2
    echo "  Sur ce dépôt, un merge vers main déclenche un déploiement dans les 5" >&2
    echo "  minutes. Le pré-check se passe AVANT de pousser sur dev ou main :" >&2
    echo "" >&2
    echo "      bash scripts/poste/precheck-mep.sh" >&2
    echo "" >&2
    echo "  Contournement assumé : SKIP_PRECHECK=1 git push ..." >&2
    echo "" >&2
    exit 1
}

#  La règle est celle du conducteur de MEP : une écriture (`lib-depot.sh`, #2908).
#  Pas d'arbre mesuré ici : le hook exige le commit exact.
verdict=$(verdict_trace_precheck "$(cat "$MARQUEUR" 2>/dev/null)" "$protege" "$(date +%s)" "")
[ "$verdict" = OK ] || refuser "${verdict#REFUS: }."
age=$(( $(date +%s) - $(cut -d' ' -f2 "$MARQUEUR") ))

echo "✓ pre-push : pré-check MEP validé pour ${protege%"${protege#???????}"} (il y a $(( age / 60 )) min)."
exit 0
