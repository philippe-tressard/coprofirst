# ─────────────────────────────────────────────
#  Hostachy — Configuration (copier vers .env)
# ─────────────────────────────────────────────

# Adresse publique servie — lue par docker-compose.yml (service `front`).
# Le TLS est assuré par le tunnel Cloudflare : le Caddyfile écoute `:80`, et
# aucun nom de domaine n'est à déclarer ici.
ORIGIN=https://example.com
# Les noms qui désignent cette copropriété (#1751) : celui d'`ORIGIN`, plus ceux-ci,
# séparés par des virgules. Un nom inconnu reçoit 421, jamais le site. Une IP privée
# et `localhost` (scripts, sondes) sont reconnus tant que l'installation ne sert
# qu'une copropriété ; `/health` répond à tout nom.
HOTES_COPROPRIETE=

# Identité du noeud, affichée au pied de page et dans la colonne « Noeud » des
# tâches planifiées. `rpi1` ou `rpi2` en production, vide en local.
INSTANCE_ID=

# Rôle de cette installation dans la distribution CoproFirst, affiché dans
# Administration › Maintenance : `reference` (suit la branche main — 5Hostachy, ses
# deux RPi) ou `replique` (suit replica — posé d'office par
# deploiement/standard/compose.images.yml). Vide : « Inconnu », jamais « Référence ».
ROLE_INSTALLATION=

# La DÉMO PUBLIQUE (specs/architecture/mode-demo.md) : `oui` ferme l'inscription, les
# réglages, l'exploitation et les téléversements, et ouvre l'entrée par personnage.
# Vide : une installation ordinaire. Jamais posé sur une installation qui sert une
# vraie copropriété.
MODE_DEMO=
# Les textes légaux de la démo (app/demo/legal.py) : l'éditeur — vide, la démo se
# déclare éditée à titre non professionnel (LCEN 6-III-2) — et l'adresse où exercer
# ses droits, requise pour la mise en service. Ignorés hors démo.
DEMO_EDITEUR=
DEMO_CONTACT=
# Les mots de passe FIXES des deux comptes techniques de la démo (#1985). Vides :
# aléatoires, écrits dans le journal de la remise à zéro.
#  - l'administrateur (admin@localhost, admin seul) : l'auteur PEUT le publier sur
#    la page « Démo » — les gestes qui reconfigurent l'installation sont fermés ;
#  - l'opérateur (operateur@localhost, admin + opérateur : registre, santé, base) :
#    SECRET, jamais publié.
DEMO_ADMIN_MOT_DE_PASSE=
DEMO_OPERATEUR_MOT_DE_PASSE=

# La version promue qu'une RÉPLIQUE installe (deploiement/standard) ; vide chez la
# référence. Le registre la lit dans le rapport et le bail.
COPROFIRST_VERSION=

# Le REGISTRE DES INSTALLATIONS (référence seule, spec §4.11) : sa base, DISTINCTE
# de celle de la résidence (`postgresql+psycopg://plateforme:<mot de passe>@postgres:5432/plateforme`),
# et le nom dédié sous lequel il répond aux installations. Vides : registre éteint
# — l'état normal de toute réplique.
PLATEFORME_DATABASE_URL=
HOTE_REGISTRE=

# L'adresse de l'OPÉRATEUR de l'installation : elle reçoit les alertes de la
# plateforme (disque du serveur), envoyées par le SMTP ci-dessous (`MAIL_*`, avec
# MAIL_ENABLED=true), depuis MAIL_FROM_PLATEFORME — l'adresse de l'installation, pas
# celle d'une copropriété. Vide : l'alerte n'est que journalisée.
COURRIEL_OPERATEUR=
MAIL_FROM_PLATEFORME=

# Le BAIL du registre (R2, spec §4.11). Chez la RÉFÉRENCE seule : la clé qui signe
# les baux, créée sur l'actif par scripts/exploitation/creer-cle-baux.sh — jamais
# écrite à la main. Côté INSTALLATION : où joindre le registre, où ranger la clé et
# l'état d'inscription (volume app_data), et le mode ESSAI (n'appelle jamais la
# référence ; admis seulement pour un hôte local ou une base en mémoire).
CLE_SIGNATURE_BAUX=
REGISTRE_URL=https://registre.coprofirst.fr
INSTALLATION_DIR=/app/data/installation
INSTALLATION_ESSAI=false

# Niveau des journaux de l'API (DEBUG, INFO, WARNING…). Lu par `main.py`.
LOG_LEVEL=INFO

# Sécurité
SECRET_KEY=changez-cette-valeur-secrete-en-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true   # false uniquement pour le développement HTTP local
ENABLE_API_DOCS=false  # true pour exposer /docs et /redoc (dev uniquement)

# Base de données
DATABASE_URL=sqlite:////app/data/app.db
# PostgreSQL (DI-7, #1759) — ÉTEINT tant que la bascule des données n'est pas
# faite. Pour l'allumer : décommenter les trois lignes, puis `docker compose up -d`.
# Le mot de passe n'a PAS de défaut : sans lui, la base refuse de s'initialiser.
# COMPOSE_PROFILES=postgresql
# POSTGRES_PASSWORD=<openssl rand -hex 32>
# PG_REPLICATION_PASSWORD=<openssl rand -hex 32>   (le même sur les deux nœuds)
# PG_ECOUTE=<IP du LAN de CE nœud>                 (réplication vers l'autre Pi)
# DATABASE_URL=postgresql+psycopg://coprofirst:<POSTGRES_PASSWORD>@postgres:5432/coprofirst

# Email (SMTP ou relay)
MAIL_ENABLED=false
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Ma Résidence"
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Sauvegardes
BACKUP_DIR=/backups
BACKUP_HOUR=3
BACKUP_KEEP_VERSIONS=3

# Maintenance cron (clé partagée script ↔ API)
MAINTENANCE_KEY=

# WhatsApp — UNE clé, lue par l'API ET par le bridge (#1596) ; elle ne se saisit
# plus dans l'administration. Le bridge refuse de démarrer avec cette valeur
# d'exemple ou une clé de moins de 16 caractères : openssl rand -hex 24
WHATSAPP_API_KEY=changez-cette-cle-whatsapp-min-16-chars
