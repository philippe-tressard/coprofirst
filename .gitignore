# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.env
!env.example
!_template.env

# Fichiers de donnees locaux (ne pas versionner)
*.db

# Secrets & config locaux
.env
.env.local
.env.*.local
# Copies manuelles du .env (`.env.avant-1109`, `.env.sauvegarde`...) : elles portent
# SECRET_KEY et SMTP, et git status les listait `??` (#1609). Seul le gabarit se versionne.
.env.*
!.env.example
secrets/
.active
# Marque posée sur l'actif par le standby qui redémarre pour son noyau (#1395)
.redemarrage-noyau
*.bak

# Node / frontend
node_modules/
front/node_modules/
front/.svelte-kit/
front/build/
front/.env
front/.env.local

# Playwright — sorties de tests, jamais versionnées
front/e2e-rapport/
front/test-results/
front/e2e-sortie.log
#  Toute sortie d'outil à la racine du front (#1601 : svelte_errors.txt
#  y était versionné depuis le premier commit public).
front/*.txt
front/*.log
front/.e2e-en-cours
front/playwright/.cache/

# Donnees runtime
data/
backups/
logs/

# Docker
*.override.yml

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp

# Claude Code — `CLAUDE.md` et `.claude/` SONT versionnés (consignes du projet).
# Overrides Claude Code personnels — versionner .claude/settings.json + hooks, PAS le local
.claude/settings.local.json

# Fichiers temporaires / scripts de fix one-shot
fix_*.py
_fix*.py
fix*.py

# Donnees d'import (contiennent potentiellement des donnees personnelles)
import-data/*.xlsx
import-data/*.csv
