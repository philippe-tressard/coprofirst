# ── L'adresse du VISITEUR (#1300, 25/09/2026) ────────────────────────────────
# cloudflared tourne sur l'HÔTE : son trafic arrive de la passerelle du réseau
# Docker. On lui fait confiance — et à lui seul, le LAN (192.168.1.x) n'est pas
# dedans — pour lire `Cf-Connecting-Ip`, que Cloudflare pose. Pas
# X-Forwarded-For : Cloudflare AJOUTE à celui du client, dont la partie gauche
# est donc falsifiable. Le même réseau est déclaré à uvicorn (`api/start.sh`),
# et `api/tests/test_adresse_client.py` exige que les deux concordent.
{
	servers {
		trusted_proxies static 172.16.0.0/12
		client_ip_headers Cf-Connecting-Ip
	}
}

:80 {
	# TLS géré par Cloudflare Tunnel (pas de TLS local nécessaire)
	encode zstd gzip

	# Headers de sécurité
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-XSS-Protection "0"
		-Server

		#  ── Content-Security-Policy : le SOUS-ENSEMBLE SÛR, et rien de plus ──
		#
		#  Le site n'en avait aucune. C'est le seul en-tête que l'audit de
		#  sécurité réclame et qui manquait ici (20/08/2026).
		#
		#  🔴 Ces quatre directives sont posées parce qu'elles ne peuvent RIEN
		#  casser : elles ne touchent ni aux scripts, ni aux styles, ni aux
		#  images. Elles ferment pourtant quatre voies réelles :
		#
		#    frame-ancestors 'none'   personne ne peut enchâsser le site pour
		#                             détourner un clic (doublon volontaire de
		#                             X-Frame-Options, qui ne couvre pas tous
		#                             les navigateurs de la même façon) ;
		#    object-src 'none'        aucun greffon (Flash, applet) ne démarre ;
		#    base-uri 'self'          une balise <base> injectée ne peut plus
		#                             réécrire la cible de TOUTES les URL
		#                             relatives de la page ;
		#    form-action 'self'       un formulaire injecté ne peut plus poster
		#                             les identifiants ailleurs.
		#
		#  ⚠️ `script-src` et `style-src` NE SONT PAS ici, et c'est délibéré.
		#  Ce sont eux qui apportent l'essentiel de la protection, et eux qui
		#  cassent une application SvelteKit si on les pose sans mesurer : styles
		#  en ligne, hydratation, polices. Une CSP fausse rend le site blanc —
		#  un remède plus grave que le mal, posé sans pouvoir l'observer.
		#  Leur mise en place demande un déploiement suivi en `Report-Only`
		#  d'abord. Suivi en issue.
		#  ── `connect-src 'self'` REJOINT le mode bloquant (01/09/2026, #536) ──
		#
		#  🔴 C'est la directive la plus utile de la politique, et la seule que le
		#  relevé permettait de poser sans parier : sur 104 rapports et six
		#  violations distinctes, **aucune ne concerne `connect-src`**. L'API, la
		#  télémétrie et le service worker sont tous sur la même origine.
		#
		#  Ce qu'elle ferme : même si un XSS s'exécutait — ce contre quoi
		#  `script-src` protégerait, et qu'on ne peut pas poser ici, voir plus bas
		#  — il ne pourrait **rien exfiltrer** vers un domaine tiers. `fetch`,
		#  `XMLHttpRequest`, WebSocket, `EventSource` et `sendBeacon` sont tous
		#  couverts. C'est la seconde moitié du travail : empêcher l'exécution, et
		#  à défaut empêcher la sortie.
		#
		#  ⚠️ Elle coupe de fait l'émission du beacon Cloudflare Web Analytics
		#  (`static.cloudflareinsights.com`), relevé le même jour et suivi en
		#  #701. C'est assumé et annoncé, pas un effet de bord découvert après :
		#  le site mesure déjà son audience in-process (`Admin → Télémétrie`).
		#
		#  ⚠️ `default-src` reste ABSENT du mode bloquant, et le motif a changé
		#  le 06/09/2026 : il ne couvre plus un trou, il en créerait un. Posé
		#  ici, il hériterait à `script-src` la valeur de Caddy, qui ignore les
		#  condensats de SvelteKit — et l'en-tête le plus strict gagnant, il
		#  bloquerait l'hydratation. Chaque directive bloquante est nommée une
		#  par une, et les scripts sont nommés ailleurs.
		#  ── CE QUE LE RELEVÉ AUTORISE À BLOQUER (#770, 05/09/2026) ──
		#
		#  `font-src` et `style-src` sont passés en mode BLOQUANT parce que le
		#  compteur persistant (`ConfigSite.csp_violations`, servi par
		#  `GET /admin/csp-violations`, retiré le 01/10/2026) ne leur attribue
		#  AUCUNE violation sur 404 rapports.
		#
		#  ⚠️ `img-src` reste dehors : ses trois violations viennent d'une
		#  extension de navigateur (1Password injecte `https://images/icons/…`),
		#  donc d'aucune ressource du site. Le bloquer ne protégerait rien et
		#  casserait l'affichage de l'extension chez le visiteur — ce n'est pas
		#  à nous d'en décider.
		#
		#  ✅ `script-src` EST DÉSORMAIS BLOQUANT — mais il n'est pas écrit ici,
		#  et c'est le cœur de #770 (06/09/2026). SvelteKit sert un script inline
		#  par page (hydratation) : il totalisait 370 des 404 violations. Seul le
		#  framework connaît le contenu de ses scripts, donc seul lui peut en
		#  calculer le condensat — `kit.csp` (mode `hash`) dans
		#  `front/svelte.config.js` émet `script-src 'self' 'sha256-…'`.
		#
		#  🔴 D'où le `+` : dans un bloc `header`, écrire le nom nu REMPLACE.
		#  Sans lui, Caddy écraserait le condensat de SvelteKit et le site
		#  deviendrait blanc — la panne exacte que #770 voulait éviter. Avec `+`,
		#  les deux en-têtes coexistent : un navigateur les applique TOUS, chacun
		#  sur ce qu'il nomme. Ici ils sont disjoints — Caddy ne dit rien des
		#  scripts, SvelteKit ne dit rien du reste.
		+Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; connect-src 'self'; font-src 'self' data:; style-src 'self' 'unsafe-inline'"

		#  ── Le MODE OBSERVATION a pris fin le 01/10/2026 ──
		#
		#  Un second en-tête `Content-Security-Policy-Report-Only` postait ici les
		#  violations à `/api/csp-report`, lues dans `Admin → Sécurité (CSP)`
		#  (#536). Il a servi à décider, sur relevé, chaque passage en bloquant :
		#  `connect-src` (01/09), `font-src` et `style-src` (05/09), `script-src`
		#  par SvelteKit (06/09). Il ne mesurait plus que `img-src`, dont les
		#  seules violations venaient d'une extension de navigateur (1Password) —
		#  une décision déjà prise : ce n'est pas au site de la bloquer.
		#
		#  En-tête, point de collecte PUBLIC et écran sont donc retirés ensemble :
		#  garder la collecte sans l'écran referait un contrôle sans destinataire
		#  (`standards/04` §7). Pour mesurer un pas nouveau (`style-src` sans
		#  `'unsafe-inline'`, le jour où #607 rouvre), les rétablir depuis
		#  l'historique git (v2.90.3).
	}

	# API — proxy vers FastAPI
	handle /api/* {
		# Le corps d'une requête est plafonné (#2164) : la plus grosse famille de
		# fichiers reçus (`document_prive`, 30 Mo — `api/app/utils/fichiers.py`,
		# FAMILLES) plus l'enveloppe multipart. Au-delà, Caddy refuse (413) avant
		# que l'API ne reçoive un octet. 🔒 test_televersement_source_unique.
		request_body {
			max_size 40MB
		}
		uri strip_prefix /api
		# ⚠️ SANS CETTE LIGNE, TOUT ENDPOINT SERVANT UN FICHIER DEVIENT PUBLIC.
		# Cloudflare met en cache d'après l'EXTENSION de l'URL. Les endpoints de
		# téléchargement en portent une (`…/photo/x.png`, `…/fichier/y.pdf`) :
		# le premier accès autorisé peuple l'edge, qui sert ensuite le fichier à
		# tout le monde sans revenir à l'origine. Constaté deux fois le
		# 03/08/2026 — sur /uploads/* le matin, puis ici l'après-midi, parce que
		# la directive n'avait été posée que sur le premier bloc.
		# Appliqué à TOUT /api/* et pas aux seules routes de fichiers : une
		# réponse d'API dépend d'une session par nature, et la prochaine route
		# qui servira un fichier n'aura pas à y penser.
		header Cache-Control "private, no-store"
		# UN X-Forwarded-For, écrasé : l'adresse que Caddy a établie ci-dessus
		# (#1300). Les limites de débit de l'API valent ainsi PAR VISITEUR.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Annonces de hall — jamais servies en direct (accès via /api/annonces-hall/{id}/pdf,
	# réservé au CS et à l'admin). Doit précéder le handle /uploads/* ci-dessous.
	handle /uploads/annonces-hall/* {
		respond 404
	}

	# Fichiers privés — bibliothèque documentaire (PV d'AG, règlement, plan
	# pluriannuel) et rapports de diagnostic. Ils se téléchargent par un endpoint
	# authentifié qui applique `document_visible` ; les servir ici contournerait ce
	# contrôle pour qui connaît l'URL. Ils vivaient à la racine du volume jusqu'au
	# 03/08/2026 — 48 fichiers exposés.
	# ⚠️ Comme le bloc ci-dessus, DOIT précéder le handle /uploads/* : Caddy applique
	# le premier `handle` qui correspond. Placé après, il ne servirait à rien.
	# Verrouillé par api/tests/test_uploads_prives.py.
	handle /uploads/prive/* {
		respond 404
	}

	# `/uploads/publications/*` a été servi ici SANS session jusqu'au 30/09/2026
	# (#1494), pour un bridge WhatsApp qui allait y chercher les images en anonyme.
	# Il les reçoit en base64 depuis le 10/08/2026 (`utils/whatsapp_media.py`) :
	# le dossier suit désormais la règle commune ci-dessous. Un bloc placé avant
	# elle ne sert qu'à REFUSER — api/tests/test_uploads_prives.py le vérifie.

	# Tout le reste des fichiers uploadés — photos de profil, photos de ticket,
	# pièces jointes. Caddy interroge l'API avant de servir : 204 si CE fichier se
	# lit, 401 sans session, 404 si l'objet qui le cite (affaire, message interne,
	# annonce…) ne se lit pas — `forward_auth` transmet l'adresse demandée dans
	# `X-Forwarded-Uri`, et la règle vit dans `utils/visibility/fichiers` (#2154).
	handle /uploads/* {
		# `forward_auth` transmet les en-têtes de la requête d'origine — donc le
		# cookie de session — et ne sert le fichier que sur une réponse 2xx.
		# Pas de `copy_headers` ici : cette sous-directive recopie des en-têtes de
		# la RÉPONSE d'authentification vers la requête, ce qui n'a rien à voir.
		forward_auth api:8000 {
			uri /auth/verifier-acces
		}
		# ⚠️ SANS CETTE LIGNE, LE CONTRÔLE CI-DESSUS NE SERT À RIEN.
		# Cloudflare met en cache les extensions statiques (.pdf, .jpg…) par
		# défaut. Le premier accès AUTORISÉ peuple donc l'edge, qui sert ensuite
		# le fichier à tout le monde sans jamais revenir à l'origine — 4 heures
		# durant. Constaté le 03/08/2026 sur une pièce jointe de ticket :
		# origine 401, edge 200 avec `CF-Cache-Status: HIT`.
		# `private` interdit le stockage aux caches partagés, `no-store` aux
		# caches privés : une réponse qui dépend d'un cookie de session ne doit
		# être conservée nulle part.
		header Cache-Control "private, no-store"
		root * /srv
		file_server
	}

	# Service worker et manifeste — JAMAIS mis en cache par un intermédiaire.
	#
	# Cloudflare met en cache d'après l'EXTENSION : `/sw.js` était servi depuis
	# l'edge pendant les 4 heures du `max-age` d'adapter-node. Un service worker
	# corrigé n'atteignait donc AUCUN navigateur avant l'expiration — constaté le
	# 14/08/2026 : le fichier était juste dans le conteneur (rebuild de 14:44) et
	# l'edge servait encore celui de 10:04, avec le repli de navigation fautif.
	#
	# `>` REMPLACE l'en-tête ; sans lui, `header` AJOUTE et la valeur d'amont
	# subsiste. Constaté au post-check du 14/08/2026, la première écriture de ce
	# bloc ayant produit « max-age=14400, must-revalidate » : le `no-cache` avait
	# disparu dans la fusion, et l'edge gardait son droit de cacher quatre heures.
	# Le contrôle regardait le bon fait — l'en-tête RÉELLEMENT servi, cache edge
	# contourné — et c'est ce qui l'a trouvé.
	# C'est le pire fichier à mettre en cache longuement : il décide de ce que
	# tous les autres deviennent. `no-cache` n'interdit pas de le stocker, il
	# impose de le revalider — ce que le navigateur fait déjà de lui-même, et que
	# l'edge ne faisait pas.
	handle /sw.js {
		header >Cache-Control "no-cache, must-revalidate"
		reverse_proxy front:3000
	}
	handle /manifest.webmanifest {
		header >Cache-Control "no-cache, must-revalidate"
		reverse_proxy front:3000
	}

	# 🔴 LE MANUEL, pour la même raison — signalé à l'écran le 04/09/2026 :
	# « je ne vois pas le menu générer un PDF » alors que la production servait
	# bien la bonne version. Le navigateur montrait la 3.87, l'origine la 3.88.
	#
	# Ce fichier ne portait AUCUN `Cache-Control` : le navigateur applique alors
	# sa propre heuristique, calculée sur `Last-Modified`. Un document qui change
	# à chaque lot et qu'on sert sans directive sera lu périmé — et personne ne
	# le sait, puisque la page s'affiche parfaitement.
	#
	# ⚠️ C'est la troisième fois que ce défaut se manifeste sous une autre forme
	# (bandeau PWA v2.24.0, `sw.js` le 14/08). Le remède est le même : `no-cache`
	# n'interdit pas de stocker, il impose de revalider.
	handle /manuel-utilisateur.html {
		header >Cache-Control "no-cache, must-revalidate"
		reverse_proxy front:3000
	}

	# `security.txt` (RFC 9116) : la RFC exige `text/plain; charset=utf-8`, et le
	# serveur du front pose `text/plain` seul — un fichier accentué serait lu dans
	# le jeu de caractères que devine le client. Le contenu : `front/static/`.
	handle /.well-known/security.txt {
		header >Content-Type "text/plain; charset=utf-8"
		reverse_proxy front:3000
	}

	# Frontend SvelteKit (SSR)
	handle {
		reverse_proxy front:3000
	}

	#  ── Journal d'accès : il SURVIT aux déploiements, et il est ANONYME (#1588) ──
	#
	#  Il était écrit sur la sortie standard du conteneur, que `docker compose up -d`
	#  recrée à chaque déploiement : 70 lignes au moment de l'audit du 02/10/2026,
	#  donc aucun 5xx de la veille n'était observable. Il va dans un fichier du
	#  volume `caddy_logs`, roulé par taille et par âge — au plus 7 jours.
	#
	#  🔴 Aucune donnée personnelle n'y entre (même arbitrage que #1300, uvicorn) :
	#  ni l'adresse du visiteur, ni les en-têtes (cookie de session, agent), ni la
	#  chaîne de requête (`?token=…` d'un lien à usage unique). Il reste la date, la
	#  méthode, le chemin, le statut, la durée et la taille — de quoi mesurer les 5xx
	#  et les routes lentes, rien de plus. Un journal qui porterait des adresses
	#  imposerait de déclarer sa durée dans la politique de confidentialité.
	#  🔒 api/tests/test_journal_acces_caddy.py
	#
	#  ⚠️ Un seul `log` par site : un second est ignoré sans un mot (éprouvé sur Caddy
	#  2.11 — la sortie standard restait vide). L'ancien journal sur stdout, qui
	#  portait les adresses, n'existe donc plus.
	log journal {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				# La chaîne de requête ET le jeton d'un lien porté par le CHEMIN
				# (`/point-cs/<jeton>`, `/api/points-conseil/lien/<jeton>/…`, #2162) :
				# une seule règle par champ, la seconde l'écraserait. Les routes à
				# jeton se déclarent dans `ROUTES_A_JETON` (test_journal_acces_caddy).
				request>uri regexp (/point-cs|/points-conseil/lien)/[^/?]+|\?.* $1
			}
		}
	}
}
